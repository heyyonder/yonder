{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yonder",
  "version": "0.1.0",
  "identifier": "so.yonder.mac",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Yonder",
        "width": 440,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../public/whoosh.m4a": "whoosh.m4a"
    },
    "externalBin": [
      "binaries/yonder-wake",
      "binaries/yonder-dictate",
      "binaries/yonder-auth",
      "binaries/yonder-select"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "Apple Development",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3Mjc0QkY2RjY0ODhBMzEKUldReGlrajI5a3NucHhCbm51UklFOUh3MFJzemoyMVVuV2g2VENGOXoxM09yUU5OeDQ2b0Q2YWQK",
      "endpoints": ["https://download.yonder.so/latest.json"]
    }
  }
}
